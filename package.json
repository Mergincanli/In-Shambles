{
  "name": "in-shambles",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @game/client --fail-if-no-match dev",
    "dev:server": "pnpm --filter @game/server --fail-if-no-match start",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:long": "vitest run --config vitest.long.config.ts",
    "test:movement": "vitest run -t \"^MV-\" --silent=false",
    "test:net": "vitest run -t \"^NET-\" --silent=false",
    "test:balance": "vitest run -t \"^BAL-\"",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "greybox": "pnpm --filter @game/tools --fail-if-no-match greybox",
    "bench": "pnpm --filter @game/tools --fail-if-no-match bench",
    "bots": "node scripts/not-yet.mjs bots M3",
    "feel-report": "pnpm --filter @game/tools --fail-if-no-match feel-report",
    "balance-report": "node scripts/not-yet.mjs balance-report M6",
    "mapc": "node scripts/not-yet.mjs mapc M5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
