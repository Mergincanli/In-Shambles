{
  "name": "in-shambles",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @game/client --fail-if-no-match dev",
    "dev:server": "pnpm --filter @game/server --fail-if-no-match start",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:movement": "node scripts/not-yet.mjs test:movement M2",
    "test:net": "node scripts/not-yet.mjs test:net M2",
    "test:balance": "vitest run -t \"^BAL-\"",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bench": "node scripts/not-yet.mjs bench M1",
    "bots": "node scripts/not-yet.mjs bots M3",
    "feel-report": "node scripts/not-yet.mjs feel-report M2",
    "balance-report": "node scripts/not-yet.mjs balance-report M6",
    "mapc": "node scripts/not-yet.mjs mapc M5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
